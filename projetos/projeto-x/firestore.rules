rules_version = '2';
// Ninguém lê ou escreve direto pelo navegador: tudo passa pelas funções do servidor,
// que usam credenciais de administrador e validam cada pedido.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
