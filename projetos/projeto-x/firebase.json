{
  "hosting": [
    {
      "target": "player",
      "public": "apps/player/dist",
      "ignore": ["**/*.map"],
      "headers": [
        { "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
        { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
      ]
    }
  ]
}
